# Copy this file to .env and fill in real values. .env is gitignored.

# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "production" on Hostinger (or any real deployment) — this is what
# makes the session cookie require HTTPS (`secure: true`). Leave unset for
# local http://localhost development, or login cookies won't be sent back.
NODE_ENV=

# ── MySQL ────────────────────────────────────────────────────────────────
# Local dev: point at your local MySQL instance, then run `npm run db:setup`.
# Hostinger: swap these for the MySQL database credentials from hPanel and
# run `npm run db:setup` again (see docs/DEPLOYMENT.md).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=longevity_blueprint

# ── OpenAI (day/week/month analyzer) ────────────────────────────────────
# Never exposed to the browser — used server-side only in src/server/lib/openai.js
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Pexels (hero images) ────────────────────────────────────────────────
# Optional — never exposed to the browser (src/server/lib/pexels.js). Without
# it, pages just show a plain title header instead of a photo, no error.
PEXELS_API_KEY=
