# Copy this file to .env.remote and fill in the values from Hostinger's
# Remote MySQL panel (hPanel → Databases → Remote MySQL). This is ONLY for
# running scripts/db/remote-query.js from your own machine against the
# production database — the deployed app itself still connects via the
# same-server 127.0.0.1 host in .env, unchanged.
#
# DB_USER / DB_PASSWORD / DB_NAME are the same production credentials
# already in .env — only the host and port differ for an external connection.

